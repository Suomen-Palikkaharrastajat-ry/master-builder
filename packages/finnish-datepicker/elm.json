    "summary": "Finnish date picker wrapper and date helpers for CurrySoftware/elm-datepicker",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [
        "FinnishDate",
        "FinnishDatePicker"
    ],
